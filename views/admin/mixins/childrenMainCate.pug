mixin treemain(items,lever = 1)
    each item ,index in items
        -const prefix = Array(lever + 1).join("-- ")
        tr  
            td 
                input(
                    type="checkbox" 
                    name = "id"
                    value = item.id
                )
            td #{index + 1}
            td
                img(
                    src=item.thumbnail
                    alt=item.title
                    width="100px"
                    height="auto"
                )
            td 
                a(
                    href=`/admin/products-category/detail/${item.id}`
                    class="titleFor"
                ) #{prefix}#{item.title}
            td
                input(
                    type="number"
                    value = item.position 
                    stype="width: 60px"
                    min="1"
                    name="position"
                )
            td
                if(item.status == "active")
                    a(
                        href="javascript:;" 
                        class="badge badge-success" 
                        buttonchangestt 
                        datastatus="active"
                        dataid = item.id
                    ) #{item.status}                      
                else
                    a(
                        href="javascript:;" 
                        class="badge badge-danger" 
                        buttonchangestt 
                        datastatus="inactive"
                        dataid = item.id
                    ) #{item.status}
            td
                a(
                    href=`/admin/products-category/edit/${item.id}`
                    class="btn btn-warning btn-sm"
                ) Editing
                button(
                    class="btn btn-danger btn-sm ml-1"
                    button-delete
                    data-id=item.id
                ) Deletes
        if item.children && item.children.length > 0
            +treemain(item.children, lever+1)

