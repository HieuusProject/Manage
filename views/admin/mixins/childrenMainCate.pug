mixin treemain(items,lever = 1)
    each item ,index in items
        -const prefix = Array(lever + 1).join("-- ")
        tr  
            td 
                input(
                    type="checkbox" 
                    name = "id"
                    value = item.id
                )
            td #{index + 1}
            td
                img(
                    src=item.thumbnail
                    alt=item.title
                    width="100px"
                    height="auto"
                )
            td 
                a(
                    href=`/admin/products-category/detail/${item.id}`
                    class="titleFor"
                ) #{prefix}#{item.title}
            td
                a(
                    href=`/admin/products-category/edit/${item.id}`
                    class="btn btn-warning btn-sm"
                ) Editing
                button(
                    class="btn btn-danger btn-sm ml-1"
                    button-delete
                    data-id=item.id
                ) Deletes
        if item.children && item.children.length > 0
            +treemain(item.children, lever+1)

    form(
        action=""
        method="POST"
        id="id-deleted-form"
        data-path="admin/products-category/delete"
    )

