extends ../../layout/default.pug
block main
    h1(class="mb-4") Fix Account
    form(
        action=`/admin/account/edit/${data.id}?_method=PATCH`
        method="POST"
        enctype="multipart/form-data"
    )
        div(class="form-group")
            label(for="fullname") Fullname
            input(
                type="text"
                class="form-control"
                id="fullname"
                name="fullname"
                required
                value=data.fullname
            )
        div(class="form-group")
            label(for="email") Email
            input(
                type="email"
                class="form-control"
                id="email"
                name="email"
                required
                value=data.email
            )
        div(class="form-group")
            label(for="password") Password
            input(
                type="password"
                class="form-control"
                id="password"
                name="password"
            )
        div(class="form-group")
            label(for="phone") Phone Number
            input(
                type="text"
                class="form-control"
                id="phone"
                name="phone"
                value=data.phone
            )
        div(
            class="form-group"
            upload-image
        )
            label(for="avatar") Avatar
            input(
                type="file"
                class="form-control-file"
                id="avatar"
                name="avatar"
                accept="image/*"
                upload-image-input 
            )
            img(src=data.avatar style="border-radius: 40px ;width: 50px ;height:50px;")
        div(class="form-group")
            label(for="role_id") Permissions
            select(name="role_id" id="role_id" class="form-control")
                option(disabled) -- Administrater --
                each item in roles
                    option(
                        value=item.id
                        selected=(item.id == data.role_id ? true : false)
                    ) #{item.title}
        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusActive"
                name="status"
                value="active"
                checked=(data.status === "active" ? true : false)
            )
            label(for="statusActive" class="form-check-label") Active
        div(class="form-group form-check form-check-inline")
            input(      
                type="radio"
                class="form-check-input"
                id="statusInActive"
                name="status"
                value="inactive"
                checked=(data.status === "active" ? false : true)
            )
            label(for="statusInActive" class="form-check-label") Inactive 
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) + Updating




