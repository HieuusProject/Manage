extends ../../layout/default.pug
block main
    h1(class="mb-4") New Category
    form(
        action = `/admin/products-category/create`
        enctype="multipart/form-data"
        method="POST"
    )
        div(class="form-group")
            label(for="title") Title
            input(
                type="text"
                class="form-control"
                id="title"
                name="title"
            )
        div(class="form-group")
            label(for="parent_id") Parent
            textarea(
                type="text"
                class="form-control"
                id="parent_id"
                name="parent_id"
            )
        div(class="form-group")
            label(for="desc") Description
            textarea(
                class="form-control"
                id="desc"
                name="description"
                rows="5"
            )
        div(
            class="form-group"
            upload-imagine
        )
            label(for="thumbnail") Imagine
            input(
                type="file"
                class="form-control-file"
                id="thumbnail"
                name="thumbnail"
                accept="image/*"
                upload-imagine-input
            )
            img(
                src=""
                upload-preview
                class="previrew-up"
            )
        div(class="form-group")
            label(for="position") Position
            input(
                type="number"
                class="form-control"
                id="position"
                name="position"
                placeholder="Automatical"
                min="1"
            )
        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusActive"
                name="status"
                value="active"
                checked
            )
            label(for="statusActive" class="form-check-label") Active
        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusInActive"
                name="status"
                value="inactive"
            )
            label(for="statusInActive" class="form-check-label") Inactive
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
        ) Create

    script(src="")





