extends ../../layout/default.pug
include ../../mixins/filterstatus.pug
include ../../mixins/search.pug
include ../../mixins/pages.pug
include ../../mixins/formchangemulti.pug
block main
    - if (messages.success)
        .message.info 
            div(
                class="alert alert-success"
                data-timeset = "5000"
                show-alert
            ) #{messages.success} 

    h1 Products Listing
    .card.mb-3 
        .card-header Findout
        .card-body  
            +search(keyword)    
    .card.mb-3
        .card-header Filting and Findout
        .card-body
            .row 
            .col-4
                div(
                    sort
                    )
                    select(
                        class="form-control"
                        name="sort"
                        sort-select
                    )
                        option(value="position-desc") Gradually Decrease
                        option(value="position-asc") Gradually Increase
                        option(value="price-desc") Grdually Increasing prices
                        option(value="price-asc") Price Descending
                        option(value="title-asc") Alphabet
                        option(value="title-desc") Alphabet Reverse
                    button(
                        class="btn btn-danger mt-2"
                        sort-clear
                    ) Clear
    .card.mb-3
        .card-header Filting and Findout
        .card-body
            .row
                +filter-status(filterStatuss)
    .card.mb-3
        .card-header Products Listing
            .card-body 
                .row
                    .col-8 
                        +formChangeMulti(`${prefixadmin}/products/change-multi?_ method=PATCH`)           
                    .col-4
                        a(
                            href=`${prefixadmin}/products/create`
                            class="btn btn-outline-success"
                        ) + New
                table(
                    class = "table table-hover table-sm"
                    checkbox-multi
                )
                    thead
                        tr
                            th
                                input(type="checkbox" name="checkall")
                            th Serial number
                            th Image
                            th Title
                            th Price 
                            th Position
                            th Status
                            th Action

                    tbody
                        each item ,index in products
                            tr  
                                td 
                                    input(
                                        type="checkbox" 
                                        name = "id"
                                        value = item.id
                                    )
                                td #{index + 1}
                                td
                                    img(
                                        src=item.thumbnail
                                        alt=item.title
                                        width="100px"
                                        height="auto"
                                    )
                                td 
                                    a(
                                        href=`/admin/products/detail/${item.id}`
                                        class="titleFor"
                                    ) #{item.title}
                                td #{item.price}
                                td
                                    input(
                                        type="number"
                                        value = item.position 
                                        stype="width: 60px"
                                        min="1"
                                        name="position"
                                    )
                                td
                                    if(item.status == "active")
                                        a(
                                            href="javascript:;" 
                                            class="badge badge-success" 
                                            buttonchangestt 
                                            datastatus="active"
                                            dataid = item.id
                                        ) #{item.status}                      
                                    else
                                        a(
                                            href="javascript:;" 
                                            class="badge badge-danger" 
                                            buttonchangestt 
                                            datastatus="inactive"
                                            dataid = item.id
                                        ) #{item.status}
                                td
                                    a(
                                        href=`/admin/products/edit/${item.id}`
                                        class="btn btn-warning btn-sm"
                                    ) Editing
                                    button(
                                        class="btn btn-danger btn-sm ml-1"
                                        button-delete
                                        data-id=item.id
                                    ) Deletes
            nav
                +pages(objectpani.currentpages,objectpani.totalpage)
    form(
        action = ""
        method = "POST"
        id = "form-changestatus"
        datapath = `${prefixadmin}/products/change-status`
    )
    form(
        action = ""
        method = "POST"
        id = "form-delete-item"
        datapath = `${prefixadmin}/products/delete`
    )
    script(src="/admin/js/products.js")