extends ../../layout/default.pug
block main

    h1(class="mb-4") Rights Group
    .card.mb-3
        .card-header List
        .card-body
            .row
                .col-8
                    a(
                        href= '/admin/roles/create'
                        class="btn btn-outline-success"
                    ) +New
            table(
                class="table table-hover table-sm"
            )
                thead
                    tr
                        th STT
                        th Nhóm quyền
                        th Mô tả ngân
                        th Hành động
                tbody
                    if(records.length > 0)
                        each item,index in records
                            tr
                                td #{index + 1}
                                td 
                                    a(href=`/admin/roles/detail/${item.id}` style="color:black;") #{item.title}
                                td 
                                    p(
                                        style="position:relative;display: inline;"
                                        id="scripts"
                                        privatep=item.id
                                        data-path=`/admin/roles/detail/${item.id}`
                                    ) #{item.description}
                                    a(  
                                        style="color:black; display:none; position:relative;"
                                        id="displayed"
                                        privatea=item.id
                                        href=`/admin/roles/detail/${item.id}`
                                    ) ...More
                                td
                                    a(
                                        class="btn btn-warning btn-sm ml-1"
                                        href=`/admin/roles/edit/${item.id}`
                                    ) Fix

                                    button(
                                        class="btn btn-danger btn-sm ml-1"
                                    ) Eliminated
                    else
                        tr
                            td(colspan="4" class="text-center") 404 Error not Found
    script(src="/admin/js/permis.js")

