extends ../../layout/default.pug
block main
    h1(class="mb-4") Permissions Adminisratoir
    div(data-records = records)
    div(class="text-right")
    button(
        type="submit"
        class="btn btn-primary mb-3"
        button-submit
    ) Updating

    table(
        class="table table-hover table-sm"
        table-permission
    )
        thead
            tr
                th Features
                each item in records
                    th(class="text-center") #{item.title}
        tbody
            tr(data-name = "id" class="d-none" )
                td
                each item in records
                    td(class="text-center")
                        input(type="text" value=item.id)
            tr
                td(colspan="4")
                    b Authorities
            tr(data-name="products-category_view")
                td View
                each item in records
                    td(class="text-center")
                        input(type="checkbox")
            tr(data-name="products-category_create")
                td Create
                each item in records
                    td(class="text-center")
                        input(type="checkbox")
            tr(data-name="products-category_edit")
                td Fixxing
                each item in records
                    td(class="text-center")
                        input(type="checkbox")
            tr(data-name="products-category_delete")
                td Elininate
                each item in records
                    td(class="text-center")
                        input(type="checkbox")
    form(
        id="form-change-permissions"
        method="POST"
        action="/admin/roles/permissions?_method=PATCH"
    )
        div(class="form-group" class="d-none")
            input(
                type="text"
                class="form-control"
                name="permissions"
            )
    script(src="/admin/js/permis.js")

